---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getAllPosts, getPostCategories } from "../../lib/wordpress.js";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const posts = await getAllPosts();
const post = posts.find((item) => item.slug === Astro.params.slug);

if (!post) {
  throw new Error(`게시 글을 찾을 수 없습니다: ${Astro.params.slug}`);
}

const categories = getPostCategories(post);
const sameCategoryPosts = posts.filter((item) => {
  if (item.slug === post.slug) return false;
  return getPostCategories(item).some((category) => categories.includes(category));
});
const fallbackPosts = posts.filter((item) => item.slug !== post.slug);
const relatedPosts = (sameCategoryPosts.length > 0 ? sameCategoryPosts : fallbackPosts).slice(0, 3);
---

<BlogLayout post={post} relatedPosts={relatedPosts} />
